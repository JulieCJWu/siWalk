FROM python:3.11-slim

# System dependencies
RUN apt-get update && apt-get install -y \
    wget curl unzip build-essential \
    libgomp1 \
    # SAMtools dependencies
    libbz2-dev liblzma-dev libncurses5-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install BLAST+
RUN wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.14.0/ncbi-blast-2.14.0+-x64-linux.tar.gz \
    && tar -xzf ncbi-blast-2.14.0+-x64-linux.tar.gz \
    && cp ncbi-blast-2.14.0+/bin/* /usr/local/bin/ \
    && rm -rf ncbi-blast-2.14.0+*

# Install SAMtools
RUN wget https://github.com/samtools/samtools/releases/download/1.17/samtools-1.17.tar.bz2 \
    && tar -xjf samtools-1.17.tar.bz2 \
    && cd samtools-1.17 && ./configure && make && make install \
    && cd .. && rm -rf samtools-1.17*

# Install Bowtie
RUN wget https://sourceforge.net/projects/bowtie-bio/files/bowtie/1.3.0/bowtie-1.3.0-linux-x86_64.zip \
    && unzip bowtie-1.3.0-linux-x86_64.zip \
    && cp bowtie-1.3.0-linux-x86_64/bowtie* /usr/local/bin/ \
    && rm -rf bowtie-1.3.0*

# Miranda (copy your local binary)
COPY lib/miranda /usr/local/bin/miranda
RUN chmod +x /usr/local/bin/miranda

# ViennaRNA — build from source or grab prebuilt
RUN wget https://www.tbi.univie.ac.at/RNA/download/sourcecode/2_5_x/ViennaRNA-2.5.1.tar.gz \
    && tar -xzf ViennaRNA-2.5.1.tar.gz \
    && cd ViennaRNA-2.5.1 && ./configure --without-perl --without-python && make && make install \
    && cd .. && rm -rf ViennaRNA-2.5.1*

# Python packages
RUN pip install --upgrade pip \
    && pip install \
        numpy scipy statsmodels \
        scikit-learn \
        pandas