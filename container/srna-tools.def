Bootstrap: docker
From: python:3.11-slim

%post
    apt-get update && apt-get install -y \
        wget curl unzip build-essential \
        libgomp1 \
        libbz2-dev liblzma-dev libncurses5-dev zlib1g-dev \
        && rm -rf /var/lib/apt/lists/*

    # BLAST+
    wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.14.0/ncbi-blast-2.14.0+-x64-linux.tar.gz \
        && tar -xzf ncbi-blast-2.14.0+-x64-linux.tar.gz \
        && cp ncbi-blast-2.14.0+/bin/* /usr/local/bin/ \
        && rm -rf ncbi-blast-2.14.0+*

    # SAMtools
    wget https://github.com/samtools/samtools/releases/download/1.17/samtools-1.17.tar.bz2 \
        && tar -xjf samtools-1.17.tar.bz2 \
        && cd samtools-1.17 && ./configure && make && make install \
        && cd .. && rm -rf samtools-1.17*

    # Bowtie
    wget https://sourceforge.net/projects/bowtie-bio/files/bowtie/1.3.0/bowtie-1.3.0-linux-x86_64.zip \
        && unzip bowtie-1.3.0-linux-x86_64.zip \
        && cp bowtie-1.3.0-linux-x86_64/bowtie* /usr/local/bin/ \
        && rm -rf bowtie-1.3.0*

    # ViennaRNA
    wget https://www.tbi.univie.ac.at/RNA/download/sourcecode/2_5_x/ViennaRNA-2.5.1.tar.gz \
        && tar -xzf ViennaRNA-2.5.1.tar.gz \
        && cd ViennaRNA-2.5.1 && ./configure --without-perl --without-python && make && make install \
        && cd .. && rm -rf ViennaRNA-2.5.1*

    # Python packages
    pip install --upgrade pip \
        && pip install numpy scipy statsmodels scikit-learn pandas

%files
    lib/miranda /usr/local/bin/miranda

%post
    chmod +x /usr/local/bin/miranda

%environment
    export PATH=/usr/local/bin:$PATH